# Works without a .env: docker compose up --build
# To change a setting, copy this file to .env and edit it
# App: http://localhost:8080   Emails: http://localhost:8025

WEB_PORT=8080
MAIL_PORT=8025

POSTGRES_DB=gymflow
POSTGRES_USER=gymflow
POSTGRES_PASSWORD=gymflow

# Any random text of 32+ characters
JWT_SECRET=change-me-to-a-long-random-string-0123456789

ADMIN_EMAIL=admin@gymflow.local
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Erion Janova
DEMO_GYM=true

# With no Stripe key, demo payments let anyone try subscribing without a card
DEMO_PAYMENTS=true

# Optional: real Stripe test checkout, keys from https://dashboard.stripe.com/test/apikeys
# When set, Stripe is used instead of demo payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
